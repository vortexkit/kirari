{
  "name": "@vortexlabs/kirari",
  "version": "1.2.0",
  "description": "Renamed to kirari. This package re-exports kirari so existing imports keep working.",
  "keywords": [
    "syntax-highlighting",
    "highlighter",
    "tokenizer",
    "code"
  ],
  "author": "Ugi (https://ugi.dev)",
  "license": "MIT",
  "homepage": "https://kirari.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vortexkit/kirari.git",
    "directory": "packages/compat"
  },
  "type": "module",
  "sideEffects": [
    "./themes/*.css"
  ],
  "files": [
    "dist",
    "themes",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js"
    },
    "./decorations": {
      "types": "./dist/decorations.d.ts",
      "import": "./dist/decorations.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./languages": {
      "types": "./dist/languages.d.ts",
      "import": "./dist/languages.js"
    },
    "./languages/*": {
      "types": "./dist/languages/*.d.ts",
      "import": "./dist/languages/*.js"
    },
    "./theme.css": "./themes/default.css",
    "./themes/*.css": "./themes/*.css"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit",
    "check": "bun run build && bun run typecheck && bun test ./test",
    "prepublishOnly": "bun run build"
  },
  "packageManager": "bun@1.3.11",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "kirari": "workspace:^"
  }
}
