{
  "name": "kirari-rehype",
  "version": "1.1.0",
  "description": "Kirari syntax highlighting for Rehype and MDX.",
  "keywords": [
    "rehype",
    "rehype-plugin",
    "mdx",
    "syntax-highlighting"
  ],
  "author": "Ugi (https://ugi.dev)",
  "license": "MIT",
  "homepage": "https://kirari.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vortexkit/kirari.git",
    "directory": "packages/rehype"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build && bun test ./checks",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@types/hast": "^3.0.5"
  },
  "peerDependencies": {
    "kirari": "^1.2.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "kirari": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
