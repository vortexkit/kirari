{
  "name": "@vortexlabs/kirari",
  "version": "1.1.1",
  "description": "Small, extensible syntax highlighting without a DOM.",
  "keywords": [
    "syntax-highlighting",
    "highlighter",
    "tokenizer",
    "code"
  ],
  "author": "Ugi (https://ugi.dev)",
  "license": "MIT",
  "homepage": "https://kirari.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vortexkit/kirari.git",
    "directory": "packages/kirari"
  },
  "type": "module",
  "sideEffects": [
    "./themes/*.css"
  ],
  "files": [
    "dist",
    "themes",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js"
    },
    "./decorations": {
      "types": "./dist/decorations.d.ts",
      "import": "./dist/decorations.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./languages": {
      "types": "./dist/languages.d.ts",
      "import": "./dist/languages.js"
    },
    "./languages/*": {
      "types": "./dist/languages/*.d.ts",
      "import": "./dist/languages/*.js"
    },
    "./theme.css": "./themes/default.css",
    "./themes/*.css": "./themes/*.css"
  },
  "scripts": {
    "themes": "bun scripts/themes.ts",
    "test": "bun test ./test",
    "test:corpus": "bun test ./test/corpus.test.ts",
    "test:fuzz": "KIRARI_FUZZ_RUNS=20000 bun test ./test/stream-fuzz.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "size": "bun scripts/size.ts",
    "check:browser": "bun run build && bun checks/browser.ts",
    "check": "bun run typecheck && bun test ./test && bun run build && bun test ./checks && bun run size",
    "prepublishOnly": "bun run build"
  },
  "packageManager": "bun@1.3.11",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
